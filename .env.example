# =========================================================================
# Environment Configuration Template for Employee Leave Platform
# Copy this file to .env and customize secrets for your environment
# =========================================================================

# Application Port
SERVER_PORT=8080

# Database Configuration (MySQL 8)
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword
DB_USERNAME=appuser
DB_PASSWORD=apppassword
DB_URL=jdbc:mysql://localhost:3306/employee_leave_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Security Configuration
# IMPORTANT: Provide a secure, random string at least 256 bits (32 bytes) long
JWT_SECRET_KEY=ReplaceThisWithAStrong256BitSecretKeyForHmacSha256InProductionEnvironments123!
JWT_EXPIRATION_MS=86400000
